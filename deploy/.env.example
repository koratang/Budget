# 复制为 .env 后填写。APP_ENV=prod 时开发身份切换必须关闭（DEV_IDENTITY_SWITCH=false），否则服务拒绝启动
APP_ENV=prod
DEV_IDENTITY_SWITCH=false
APP_PORT=8000
DB_PASSWORD=请修改为强密码
# 钉钉企业内部应用（信息数字化部提供，2026-11-30 前就绪）
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_AGENT_ID=
DINGTALK_CORP_ID=
# 系统对外访问地址（钉钉扫码回调与通知链接使用），例如 http://budget.intra:8000
APP_BASE_URL=
# 首位财务负责人的钉钉 userid（部署时指定，DEC 处置：第一个财务负责人由部署配置写入）
BOOTSTRAP_FINANCE_HEAD_USERID=
# 钉钉接口基地址：生产保持官方默认；本地替身验收时填 http://<替身地址>:8090
# DINGTALK_BASE_URL=
